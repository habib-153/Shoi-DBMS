import { NextRequest, NextResponse } from 'next/server';
import { query } from '@/lib/db';

// GET - Fetch session notes for a specific session
export async function GET(
  request: NextRequest,
  { params }: { params: Promise<{ id: string }> }
) {
  try {
    const { id } = await params;
    const sessionId = id;
    const { searchParams } = new URL(request.url);
    const userId = searchParams.get('userId');
    const userType = searchParams.get('userType'); // 'user' or 'therapist'

    let sql = `
      SELECT 
        sn.note_id,
        sn.session_id,
        sn.summary,
        sn.homework,
        sn.visible_to_user,
        sn.created_at,
        s.session_date,
        s.appointment_id,
        a.user_id,
        a.therapist_id
    `;

    // Only include private notes if requested by therapist
    if (userType === 'therapist') {
      sql += `, sn.therapist_private_notes`;
    }

    sql += `
      FROM session_notes sn
      JOIN sessions s ON sn.session_id = s.session_id
      JOIN appointments a ON s.appointment_id = a.appointment_id
      WHERE sn.session_id = ?
    `;

    // Filter based on visibility if user is requesting
    if (userType === 'user') {
      sql += ` AND sn.visible_to_user = 1`;
    }

    sql += ` ORDER BY sn.created_at DESC`;

    const notes = await query(sql, [sessionId]);

    return NextResponse.json({
      success: true,
      notes
    });

  } catch (error) {
    console.error('Error fetching session notes:', error);
    return NextResponse.json(
      { success: false, error: 'Failed to fetch session notes' },
      { status: 500 }
    );
  }
}

// POST - Create session note
export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ id: string }> }
) {
  try {
    const { id } = await params;
    const sessionId = id;
    const body = await request.json();
    const { summary, homework, therapist_private_notes, visible_to_user } = body;

    if (!summary && !homework && !therapist_private_notes) {
      return NextResponse.json(
        { success: false, error: 'At least one field (summary, homework, or private notes) is required' },
        { status: 400 }
      );
    }

    const result = await query(
      `INSERT INTO session_notes (session_id, summary, homework, therapist_private_notes, visible_to_user)
       VALUES (?, ?, ?, ?, ?)`,
      [
        sessionId, 
        summary || null, 
        homework || null, 
        therapist_private_notes || null, 
        visible_to_user !== undefined ? visible_to_user : true
      ]
    );

    return NextResponse.json({
      success: true,
      note_id: (result as any).insertId,
      message: 'Session note created successfully'
    });

  } catch (error) {
    console.error('Error creating session note:', error);
    return NextResponse.json(
      { success: false, error: 'Failed to create session note' },
      { status: 500 }
    );
  }
}